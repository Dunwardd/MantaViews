# Estas variables son públicas por diseño. La seguridad depende de RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google OAuth se configura en Google Cloud y Supabase, nunca con su secret en Expo.
# Nunca agregues SUPABASE_SERVICE_ROLE_KEY a una variable EXPO_PUBLIC_*.
