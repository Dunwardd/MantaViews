{
  "expo": {
    "name": "MantaViews",
    "slug": "manta-views",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mantaviews-app-icon.png",
    "scheme": "mantaviews",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mantaviews.app"
    },
    "android": {
      "package": "com.mantaviews.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EB",
        "foregroundImage": "./assets/images/mantaviews-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mantaviews-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EB",
          "image": "./assets/images/mantaviews-app-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "MantaViews necesita acceso a tus fotos para subir avatares y fotografías turísticas que serán moderadas."
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MantaViews usa tu ubicación mientras exploras para mostrar lugares cercanos y calcular rutas. No almacenamos tu ubicación."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
